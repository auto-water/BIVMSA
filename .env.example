# =============================================================================
# BIV 业务 LLM 接口配置 (OpenAI 兼容)
# 复制为 .env 并填充实际值
# =============================================================================

# 业务 LLM 接口地址，例如: http://<host>:<port>/v1
LLM_BASE_URL=

# 业务 LLM 接口 API Key
LLM_API_KEY=

# 模型名 (业务主机可选 Qwen3-32B-V1 / MiniMax-M2.7)
LLM_MODEL=deepseek-v4-flash

# 最大生成 tokens
LLM_MAX_TOKENS=8192

# LLM 重试次数
LLM_MAX_RETRIES=3
